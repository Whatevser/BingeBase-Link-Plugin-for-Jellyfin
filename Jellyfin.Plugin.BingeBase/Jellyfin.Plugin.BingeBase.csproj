<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.BingeBase</RootNamespace>
    <!-- Plugin version. Push the tag v + this value to make a release. -->
    <Version>2.2.0.0</Version>
    <!-- Oldest Jellyfin the plugin is built against; also published as targetAbi. -->
    <JellyfinVersion>12.0.0</JellyfinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/bingebase.js" LogicalName="Jellyfin.Plugin.BingeBase.bingebase.js" />
  </ItemGroup>

</Project>
